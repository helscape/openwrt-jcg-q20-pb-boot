FROM ubuntu:24.04

ARG HOST_UID=1000
ARG HOST_GID=1000

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ccache ecj fastjar file g++ gawk gettext git \
        java-propose-classpath libelf-dev libncurses5-dev libncursesw5-dev \
        libssl-dev python3 python3-setuptools python3-dev rsync subversion \
        swig time xsltproc zlib1g-dev sudo less vim wget curl ca-certificates \
        bison flex unzip libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

# If UID/GID differ from the default ubuntu user, renumber it
RUN if [ "${HOST_UID}" != "1000" ] || [ "${HOST_GID}" != "1000" ]; then \
        groupmod -g "${HOST_GID}" ubuntu && \
        usermod -u "${HOST_UID}" -g "${HOST_GID}" ubuntu; \
    fi \
    && echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu \
    && chmod 0440 /etc/sudoers.d/ubuntu

USER ubuntu
WORKDIR /build
